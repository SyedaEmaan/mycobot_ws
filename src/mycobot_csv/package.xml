<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
            schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mycobot_csv</name>
  <version>0.1.0</version>
  <description>
    Strict-mirror port of simple_ng.c into a ros2_control SystemInterface plugin.
    Drives Laifual L70I-E-100-BF in CiA 402 CSV mode (mode 9). Velocity command
    interface only. Used as the trusted baseline before migrating to CSP.
  </description>

  <maintainer email="zafarmunzir@gmail.com">Munzir</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>

  <export>
    <build_type>ament_cmake</build_type>
    <hardware_interface plugin="${prefix}/mycobot_csv_plugin.xml"/>
  </export>
</package>
