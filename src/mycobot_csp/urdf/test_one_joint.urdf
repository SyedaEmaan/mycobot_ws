<?xml version="1.0"?>
<!--
  test_one_joint.urdf — minimal one-joint URDF for verifying mycobot_csp.

  Keep this file MINIMAL. The point is to isolate the plugin from URDF
  complexity. Once the plugin is verified, swap to a real robot URDF.

  EDIT BEFORE RUNNING:
    1. <param name="ifname">       — your EtherCAT interface (`ip link`)
    2. <param name="counts_per_rad"> — encoder counts per output radian.
       Under CSP, a wrong value means commanded `+0.05 rad` lands at some
       other physical angle — but the drive will still servo cleanly to
       the target and HOLD position there. Calibrate before relying on
       absolute scale; for a first move-and-hold test, the placeholder
       below is fine.

  TEST PROTOCOL (no MoveIt, no RViz):
    1. ros2 topic echo --once /joint_states           # note position[0] = p0
    2. (no command published)                         # joint must hold still
    3. ros2 topic pub --once /forward_position_controller/commands \
         std_msgs/msg/Float64MultiArray "{data: [<p0 + 0.05>]}"
    4. ros2 topic pub --once /forward_position_controller/commands \
         std_msgs/msg/Float64MultiArray "{data: [<p0>]}"
    5. ros2 topic pub --once /forward_position_controller/commands \
         std_msgs/msg/Float64MultiArray "{data: [<p0 - 0.05>]}"
-->
<robot name="mycobot_csp_test">

  <link name="world"/>

  <link name="base_link">
    <visual>
      <geometry><box size="0.1 0.1 0.05"/></geometry>
    </visual>
  </link>

  <joint name="base_fixed" type="fixed">
    <parent link="world"/>
    <child  link="base_link"/>
  </joint>

  <link name="link_1">
    <visual>
      <geometry><cylinder length="0.2" radius="0.03"/></geometry>
      <origin xyz="0 0 0.1"/>
    </visual>
  </link>

  <joint name="joint_1" type="continuous">
    <parent link="base_link"/>
    <child  link="link_1"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="100" velocity="2.0"/>
  </joint>

  <ros2_control name="MyCobotCSPSystem" type="system">

    <hardware>
      <plugin>mycobot_csp/MyCobotCSP</plugin>
      <!-- EDIT: your EtherCAT interface name -->
      <param name="ifname">enxc8a3623069bf</param>
    </hardware>

    <joint name="joint_1">
      <param name="slave_index">1</param>
      <!-- counts_per_rad: encoder counts per radian on output side.
           Default below is a placeholder (17-bit × 100:1 / 2π).
           Calibrate before trusting the absolute angle of position commands. -->
      <param name="counts_per_rad">2085932.0</param>

      <!-- min/max here are advisory only. ForwardCommandController does
           not enforce them; values are passed straight through to the
           drive (which will reject anything outside its own 0x607D
           software position limit). Wide range chosen because joint is
           continuous and the encoder zero may be arbitrary. -->
      <command_interface name="position">
        <param name="min">-100.0</param>
        <param name="max"> 100.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

  </ros2_control>

</robot>
