<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="mycobot_280_ros2_control" params="name initial_positions_file">
        <xacro:property name="initial_positions" value="${xacro.load_yaml(initial_positions_file)['initial_positions']}"/>

        <!-- ============================================================
             Hardware Block 1: Real EtherCAT drive on joint 1 (slave 1)
             Uses the verified mycobot_csv plugin in CSV (velocity) mode.
             ============================================================ -->
        <ros2_control name="${name}_real_arm" type="system">
            <hardware>
                <plugin>mycobot_csv/MyCobotCSV</plugin>
                <!-- EDIT: change ifname to your EtherCAT interface
                     (run `ip link` to find it; commonly enxNNN... for USB-Eth) -->
                <param name="ifname">enxc8a3623069bf</param>
            </hardware>

            <joint name="link1_to_link2">
                <param name="slave_index">1</param>
                <param name="counts_per_rad">2085932.0</param>
                <command_interface name="velocity">
                    <param name="min">-2.0</param>
                    <param name="max"> 2.0</param>
                </command_interface>
                <state_interface name="position">
                    <param name="initial_value">${initial_positions['link1_to_link2']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
        </ros2_control>

        <!-- ============================================================
             Hardware Block 2: Mock joints 2-6 + gripper
             mock_components/GenericSystem echoes commands as state, so
             these joints "track" perfectly without real hardware.
             Velocity command interface keeps the trajectory controller
             interface uniform across all 6 arm joints; gripper stays on
             position because moveit_controllers.yaml uses GripperCommand.
             initial_value on each command_interface prevents NaN states
             at activation when calculate_dynamics integrates the buffer.
             ============================================================ -->
        <ros2_control name="${name}_mock_arm" type="system">
            <hardware>
                <plugin>mock_components/GenericSystem</plugin>
                <!-- mock_components can synthesize position state from velocity
                     commands; this flag asks it to do the integration. -->
                <param name="calculate_dynamics">true</param>
            </hardware>

            <joint name="link2_to_link3">
                <command_interface name="velocity">
                    <param name="initial_value">0.0</param>
                </command_interface>
                <state_interface name="position">
                    <param name="initial_value">${initial_positions['link2_to_link3']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="link3_to_link4">
                <command_interface name="velocity">
                    <param name="initial_value">0.0</param>
                </command_interface>
                <state_interface name="position">
                    <param name="initial_value">${initial_positions['link3_to_link4']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="link4_to_link5">
                <command_interface name="velocity">
                    <param name="initial_value">0.0</param>
                </command_interface>
                <state_interface name="position">
                    <param name="initial_value">${initial_positions['link4_to_link5']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="link5_to_link6">
                <command_interface name="velocity">
                    <param name="initial_value">0.0</param>
                </command_interface>
                <state_interface name="position">
                    <param name="initial_value">${initial_positions['link5_to_link6']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="link6_to_link6flange">
                <command_interface name="velocity">
                    <param name="initial_value">0.0</param>
                </command_interface>
                <state_interface name="position">
                    <param name="initial_value">${initial_positions['link6_to_link6flange']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="gripper_controller">
                <command_interface name="position">
                    <param name="initial_value">0.0</param>
                </command_interface>
                <state_interface name="position">
                    <param name="initial_value">${initial_positions['gripper_controller']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
        </ros2_control>

    </xacro:macro>
</robot>
