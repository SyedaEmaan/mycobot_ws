      <inertia ixx="0.013" iyy="0.015" izz="0.009" ixy="0.0" ixz="0.0" iyz="-0.001"/>
    </inertial>
  </link>

  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.879793" upper="2.879793" effort="5.0" velocity="2.792527"/>
  </joint>

  <link name="link2">
