<?xml version="1.0"?>
<robot name="my_robot_arm" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <material name="red">
    <color rgba="1 0 0 1"/>
  </material>
  <material name="blue">
    <color rgba="0 0.4 0.9 1"/>
  </material>

  <link name="world"/>
  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
  </joint>

  <!-- ===================== -->
  <!-- BASE LINK             -->
  <!-- ===================== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://kerabot_description/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://kerabot_description/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0.003 0.095" rpy="0 0 0"/>
      <mass value="7.98"/>
      <inertia ixx="0.021" iyy="0.021" izz="0.019" ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>
  </link>

  <link name="link1">
    <visual>
      <origin xyz="0 0.0 0.152" rpy="-3.14 0 -1.57"/>
      <geometry>
        <mesh filename="package://kerabot_description/meshes/Link_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="blue"/>
